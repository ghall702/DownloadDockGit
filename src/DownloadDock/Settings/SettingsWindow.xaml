<Window x:Class="DownloadDock.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DownloadDock.Settings"
        x:ClassModifier="internal"
        Title="DownloadDock Settings"
        Width="600" SizeToContent="Height" MaxHeight="900"
        MinWidth="480"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="14">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        </Style>
    </Window.Resources>

    <Grid Margin="24,16,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Settings" FontSize="26" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-12,0" Padding="0,0,12,0">
        <StackPanel>
            <!-- Folder -->
            <TextBlock Text="Downloads folder" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding EffectiveFolder, Mode=OneWay}" IsReadOnly="True" VerticalContentAlignment="Center" AutomationProperties.Name="Downloads folder" />
                        <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Command="{Binding BrowseCommand}" />
                        <Button Grid.Column="2" Content="Default" Margin="8,0,0,0" Command="{Binding ResetFolderCommand}" ToolTip="Use the Windows Downloads folder" />
                    </Grid>
                    <TextBlock Margin="0,6,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                <Setter Property="Text" Value="Custom folder." />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UsesDefaultFolder}" Value="True">
                                        <Setter Property="Text" Value="Using the Windows Downloads folder (follows OneDrive / drive redirection)." />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding FolderIsValid}" Value="False">
                                        <Setter Property="Text" Value="This folder doesn't exist." />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <CheckBox Margin="0,10,0,0" Content="Include files in subfolders" IsChecked="{Binding IncludeSubfolders}" />
                </StackPanel>
            </Border>

            <!-- Fan -->
            <TextBlock Text="Fan" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Visible files" VerticalAlignment="Center" />
                    <Slider Grid.Column="1" Minimum="{Binding MinVisibleFiles}" Maximum="{Binding MaxVisibleFiles}" Value="{Binding VisibleFiles}"
                            IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" AutomationProperties.Name="Visible files" />
                    <TextBlock Grid.Column="2" Text="{Binding VisibleFiles}" VerticalAlignment="Center" HorizontalAlignment="Right" />

                    <TextBlock Grid.Row="1" Text="Thumbnail size" VerticalAlignment="Center" Margin="0,12,0,0" />
                    <Slider Grid.Row="1" Grid.Column="1" Minimum="{Binding MinThumbnailSize}" Maximum="{Binding MaxThumbnailSize}" Value="{Binding ThumbnailSize}"
                            IsSnapToTickEnabled="True" TickFrequency="8" VerticalAlignment="Center" Margin="0,12,0,0" AutomationProperties.Name="Thumbnail size" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ThumbnailSize}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,12,0,0" />

                    <TextBlock Grid.Row="2" Text="Animation speed" VerticalAlignment="Center" Margin="0,12,0,0" />
                    <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding AnimationSpeeds}" SelectedItem="{Binding AnimationSpeed}" Margin="0,12,0,0" AutomationProperties.Name="Animation speed" />

                    <TextBlock Grid.Row="3" Text="Theme" VerticalAlignment="Center" Margin="0,12,0,0" />
                    <ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" Margin="0,12,0,0" AutomationProperties.Name="Theme" />
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox Content="Show file extensions" IsChecked="{Binding ShowFileExtensions}" />
                    <CheckBox Margin="0,8,0,0" Content="Close the fan after dragging a file out" IsChecked="{Binding CloseAfterDrop}" />
                </StackPanel>
            </Border>

            <!-- Screenshots -->
            <TextBlock Text="Screenshots" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox Content="Floating screenshot thumbnails and capture shortcuts" IsChecked="{Binding ScreenshotsEnabled}" />
                    <Grid Margin="0,12,0,0" IsEnabled="{Binding ScreenshotsEnabled}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Capture screen" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding FullScreenShortcutDisplay, Mode=OneWay}" IsReadOnly="True" VerticalContentAlignment="Center" AutomationProperties.Name="Capture screen shortcut" />
                        <Button Grid.Column="2" Content="Change…" Margin="8,0,0,0" Command="{Binding RecordFullScreenCommand}" />
                        <Button Grid.Column="3" Content="None" Margin="8,0,0,0" Command="{Binding ClearFullScreenCommand}" />
                        <TextBlock Grid.Row="1" Text="Capture area" VerticalAlignment="Center" Margin="0,8,0,0" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RegionShortcutDisplay, Mode=OneWay}" IsReadOnly="True" VerticalContentAlignment="Center" Margin="0,8,0,0" AutomationProperties.Name="Capture area shortcut" />
                        <Button Grid.Row="1" Grid.Column="2" Content="Change…" Margin="8,8,0,0" Command="{Binding RecordRegionCommand}" />
                        <Button Grid.Row="1" Grid.Column="3" Content="None" Margin="8,8,0,0" Command="{Binding ClearRegionCommand}" />
                    </Grid>
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource Hint}" Foreground="#FFD13438" Text="{Binding ShortcutMessage}"
                               Visibility="{Binding HasShortcutMessage, Converter={StaticResource BoolToVis}}" />
                    <Button Margin="0,8,0,0" HorizontalAlignment="Left" Content="Restore Win + Shift + 3 / 4" Command="{Binding ResetShortcutsCommand}" />

                    <TextBlock Margin="0,14,0,6" Text="Save screenshots" FontWeight="SemiBold" />
                    <RadioButton GroupName="SaveMode" Content="Automatically, in the screenshot folder" IsChecked="{Binding SaveScreenshotsPermanently}" />
                    <RadioButton GroupName="SaveMode" Margin="0,4,0,0" Content="Temporarily, until I choose Save (removed after a day)" IsChecked="{Binding SaveScreenshotsTemporarily}" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding EffectiveScreenshotFolder, Mode=OneWay}" IsReadOnly="True" VerticalContentAlignment="Center" AutomationProperties.Name="Screenshot folder" />
                        <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Command="{Binding BrowseScreenshotFolderCommand}" />
                        <Button Grid.Column="2" Content="Default" Margin="8,0,0,0" Command="{Binding ResetScreenshotFolderCommand}" ToolTip="Pictures\Screenshots" />
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Thumbnail stays for" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Minimum="{Binding MinThumbnailSeconds}" Maximum="{Binding MaxThumbnailSeconds}" Value="{Binding ThumbnailSeconds}"
                                IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" AutomationProperties.Name="Thumbnail duration" />
                        <TextBlock Grid.Column="2" Text="{Binding ThumbnailSeconds, StringFormat={}{0} s}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>

                    <CheckBox Margin="0,12,0,0" Content="Also show thumbnails for Snipping Tool, Win + Shift + S and Print Screen" IsChecked="{Binding DetectWindowsScreenshots}" />
                    <TextBlock Margin="24,4,0,0" Style="{StaticResource Hint}"
                               Text="Detected from new files in your Screenshots folder and from the Snipping Tool's clipboard images. DownloadDock only reads the clipboard; it never changes it." />
                </StackPanel>
            </Border>

            <!-- Finder for Windows -->
            <TextBlock Text="Finder Integration" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox Content="Enable Finder integration" IsChecked="{Binding FinderIntegrationEnabled}" />
                    <StackPanel Margin="24,8,0,0" IsEnabled="{Binding FinderIntegrationEnabled}">
                        <CheckBox Content="Prefer Finder when opening folders" IsChecked="{Binding PreferFinderForFolders}" />
                        <CheckBox Margin="0,6,0,0" Content="Prefer Finder for Show in folder" IsChecked="{Binding PreferFinderForReveal}" />
                        <CheckBox Margin="0,6,0,0" Content="Start Finder when it isn't running" IsChecked="{Binding LaunchFinderIfNotRunning}" />
                        <CheckBox Margin="0,6,0,0" Content="Fall back to File Explorer" IsChecked="{Binding FallBackToExplorer, Mode=OneWay}" IsEnabled="False"
                                  ToolTip="Always on: if Finder is missing, not running, busy or incompatible, File Explorer is used so Show in folder never stops working." />
                        <CheckBox Margin="0,6,0,0" Content="Allow Finder to start DownloadDock" IsChecked="{Binding AllowFinderToLaunchDownloadDock}" />
                    </StackPanel>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="10" Height="10" Margin="0,5,8,0" VerticalAlignment="Top">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#FF8A8A8A" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FinderConnected}" Value="True">
                                            <Setter Property="Fill" Value="#FF2BB34A" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding FinderStatusText}" TextWrapping="Wrap" AutomationProperties.Name="Finder connection status" />
                            <TextBlock Text="{Binding FinderVersionText}" Style="{StaticResource Hint}" Margin="0,2,0,0"
                                       Visibility="{Binding HasFinderVersion, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Hint}"
                               Text="DownloadDock and Finder talk over a private local pipe that only your Windows session can open. Files still move by normal drag-and-drop." />
                </StackPanel>
            </Border>

            <!-- System -->
            <TextBlock Text="System" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Hint}"
                               Text="To keep the icon visible next to Wi-Fi, volume and battery, turn DownloadDock on under Settings › Personalization › Taskbar › Other system tray icons, or drag it out of the ^ overflow onto the taskbar." />
                    <Button Margin="0,10,0,0" HorizontalAlignment="Left" Content="Open taskbar settings" Click="OpenTaskbarSettings_Click" />
                    <Button Margin="0,8,0,0" HorizontalAlignment="Left" Content="Clear thumbnail cache" Command="{Binding ClearCacheCommand}" />
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Save" MinWidth="96" IsDefault="True" Command="{Binding SaveCommand}" Style="{DynamicResource AccentButtonStyle}" />
            <Button Content="Cancel" MinWidth="96" Margin="8,0,0,0" IsCancel="True" Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</Window>
