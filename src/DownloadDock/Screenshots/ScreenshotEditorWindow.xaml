<Window x:Class="DownloadDock.Screenshots.ScreenshotEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Screenshot"
        Width="980" Height="700" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13">
    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="ButtonBase" BasedOn="{x:Null}">
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="MinWidth" Value="34" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <DockPanel Margin="10,8" LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <ToggleButton x:Name="PenButton" Content="✎ Pen" ToolTip="Draw (P)" Click="Pen_Click" Margin="2,0" Padding="10,5" />
                <ToggleButton x:Name="HighlighterButton" Content="▍ Highlight" ToolTip="Highlighter (H)" Click="Highlighter_Click" Margin="2,0" Padding="10,5" />
                <ToggleButton x:Name="CropButton" Content="⛶ Crop" ToolTip="Drag a rectangle to crop (C)" Click="Crop_Click" Margin="2,0" Padding="10,5" />
                <StackPanel x:Name="Swatches" Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center" />
                <Button Content="↶ Undo" ToolTip="Undo (Ctrl+Z)" Click="Undo_Click" Margin="2,0" Padding="10,5" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Border x:Name="DragHandle" CornerRadius="6" BorderThickness="1" Padding="8,3" Margin="2,0" Cursor="Hand"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        ToolTip="Drag this into any app to drop the screenshot (with your edits)"
                        PreviewMouseLeftButtonDown="DragHandle_Down" PreviewMouseMove="DragHandle_Move">
                    <StackPanel Orientation="Horizontal">
                        <Image x:Name="DragThumb" Height="24" Margin="0,0,6,0" />
                        <TextBlock Text="Drag" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Button Content="Copy" ToolTip="Copy (Ctrl+C)" Click="Copy_Click" Margin="2,0" Padding="10,5" />
                <Button Content="Save As…" Click="SaveAs_Click" Margin="2,0" Padding="10,5" />
                <Button Content="Open" ToolTip="Open in the default image app" Click="Open_Click" Margin="2,0" Padding="10,5" />
                <Button Content="Delete" Click="Delete_Click" Margin="2,0" Padding="10,5" />
                <Button Content="Done" ToolTip="Save changes and close" IsDefault="True" Click="Done_Click" Margin="6,0,0,0" Padding="16,5" Style="{DynamicResource AccentButtonStyle}" />
            </StackPanel>
        </DockPanel>

        <!-- Image surface: everything inside Surface is in image pixels, scaled to fit by the Viewbox -->
        <Border Grid.Row="1" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" Padding="16" ClipToBounds="True">
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                <Grid x:Name="Surface">
                    <Image x:Name="ShotImage" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality" />
                    <InkCanvas x:Name="Ink" Background="Transparent" EditingMode="None" />
                    <Canvas x:Name="CropLayer" Background="Transparent" Visibility="Collapsed"
                            MouseLeftButtonDown="Crop_Down" MouseMove="Crop_Move" MouseLeftButtonUp="Crop_Up" Cursor="Cross">
                        <Rectangle x:Name="CropRect" Stroke="White" StrokeThickness="2" StrokeDashArray="4 3" Fill="#33FFFFFF" Visibility="Collapsed" />
                    </Canvas>
                </Grid>
            </Viewbox>
        </Border>

        <TextBlock x:Name="Status" Grid.Row="2" Margin="14,4,14,8" Opacity="0.75" TextTrimming="CharacterEllipsis" />
    </Grid>
</Window>
