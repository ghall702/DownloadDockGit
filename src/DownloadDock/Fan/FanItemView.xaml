<UserControl x:Class="DownloadDock.Fan.FanItemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DownloadDock.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:ClassModifier="internal"
             Focusable="False"
             SnapsToDevicePixels="False"
             UseLayoutRounding="False">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <!-- The root has no background, so only the label pill and the card are hit-testable:
         clicks between neighbouring cards fall through to whatever is underneath. -->
    <Grid x:Name="Root" d:DataContext="{d:DesignInstance vm:FanItemViewModel}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LabelColumn" Width="230" />
            <ColumnDefinition x:Name="GapColumn" Width="10" />
            <ColumnDefinition x:Name="ThumbColumn" Width="96" />
        </Grid.ColumnDefinitions>

        <!-- File name pill -->
        <Border x:Name="LabelPill"
                Grid.Column="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                CornerRadius="7"
                Padding="11,5,11,6"
                BorderThickness="1"
                Cursor="Hand">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource Fan.LabelBackground}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Fan.LabelBorder}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Fan.Accent}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Fan.Accent}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.28" RenderingBias="Performance" />
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="NameText"
                           Text="{Binding DisplayName}"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           TextOptions.TextFormattingMode="Display">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Fan.LabelForeground}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Fan.AccentForeground}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Subtitle}"
                           Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVis}}"
                           FontFamily="Segoe UI Variable Small, Segoe UI"
                           FontSize="11"
                           Opacity="0.8"
                           TextTrimming="CharacterEllipsis"
                           TextOptions.TextFormattingMode="Display">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Fan.LabelForeground}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Fan.AccentForeground}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Thumbnail box: the card is centred in it so rotation pivots around the box centre. -->
        <Grid x:Name="ThumbBox" Grid.Column="2" Width="96" Height="96">
            <!-- Document / photo card -->
            <Border x:Name="Card"
                    Width="{Binding ThumbWidth}"
                    Height="{Binding ThumbHeight}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="5"
                    Cursor="Hand">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Fan.CardBorder}" />
                        <Setter Property="Background" Value="{DynamicResource Fan.PlaceholderBackground}" />
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsIcon}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasThumbnail}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                <Setter Property="BorderThickness" Value="2" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Fan.Accent}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.38" RenderingBias="Performance" />
                </Border.Effect>
                <Grid>
                    <!-- Placeholder shown until the preview arrives -->
                    <TextBlock Text="{Binding ExtensionLabel}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Foreground="{DynamicResource Fan.PlaceholderForeground}" />
                    <!-- The preview itself, clipped to the card's rounded corners via an ImageBrush -->
                    <Border x:Name="PreviewSurface" CornerRadius="4" Opacity="0">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border.Background>
                    </Border>
                </Grid>
            </Border>

            <!-- File-type icon (archives, executables, unknown types) -->
            <Image x:Name="IconImage"
                   Source="{Binding Thumbnail}"
                   Width="{Binding ThumbWidth}"
                   Height="{Binding ThumbHeight}"
                   Stretch="Uniform"
                   Cursor="Hand"
                   RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Style>
                    <Style TargetType="Image">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsIcon}" Value="True" />
                                    <Condition Binding="{Binding HasThumbnail}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
                <Image.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.35" RenderingBias="Performance" />
                </Image.Effect>
            </Image>

            <!-- Hit target for icons so the transparent parts of the icon still respond -->
            <Border x:Name="IconHitArea" Background="Transparent" Width="{Binding ThumbWidth}" Height="{Binding ThumbHeight}" Cursor="Hand">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsIcon}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </Grid>
    </Grid>
</UserControl>
